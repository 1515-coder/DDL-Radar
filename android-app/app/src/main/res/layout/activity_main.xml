<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="60dp" android:background="#FFFFFF" android:elevation="1dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="18dp">
            <Button android:id="@+id/menuButton" style="?android:attr/buttonBarButtonStyle" android:layout_width="48dp" android:layout_height="48dp" android:text="☰" android:textColor="@color/primary" android:textSize="23sp" />
            <ImageView android:id="@+id/profileAvatar" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="3dp" android:contentDescription="@string/app_name" android:scaleType="centerCrop" android:src="@drawable/avatar" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DDL Radar" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" /><TextView android:id="@+id/profileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="默认用户" android:textColor="@color/muted" android:textSize="12sp" /></LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical"><Button android:id="@+id/settingsBackButton" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="44dp" android:text="‹ 返回" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="平台与同步" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/panel_background" android:orientation="vertical" android:padding="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><CheckBox android:id="@+id/moocCheck" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:checked="true" android:text="MOOC　未认证" /><Button android:id="@+id/moocButton" android:layout_width="82dp" android:layout_height="42dp" android:text="登录" /></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><CheckBox android:id="@+id/yanheCheck" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:checked="true" android:text="延河课堂　未认证" /><Button android:id="@+id/yanheButton" android:layout_width="82dp" android:layout_height="42dp" android:text="登录" /></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><CheckBox android:id="@+id/zhiyuanCheck" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:checked="true" android:text="智园课堂　未认证" /><Button android:id="@+id/zhiyuanButton" android:layout_width="82dp" android:layout_height="42dp" android:text="登录" /></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal"><Button android:id="@+id/clearMoocButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="清除 MOOC" android:textSize="11sp"/><Button android:id="@+id/clearYanheButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="清除延河" android:textSize="11sp"/><Button android:id="@+id/clearZhiyuanButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="清除智园" android:textSize="11sp"/></LinearLayout>
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/panel_background" android:padding="8dp" android:text="@string/initial_status" android:textColor="@color/muted" android:textSize="12sp" />
            <Button android:id="@+id/syncButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:backgroundTint="@color/primary" android:text="同步已勾选平台" android:textColor="#FFFFFF" />
            <ProgressBar android:id="@+id/syncProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
            <CheckBox android:id="@+id/autoSyncCheck" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/primary" android:text="打开应用时自动更新" android:textColor="@color/ink" android:textSize="14sp" />
            <CheckBox android:id="@+id/deadlineReminderCheck" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:buttonTint="@color/primary" android:text="打开应用时提醒两天内截止任务" android:textColor="@color/ink" android:textSize="14sp" />
            <Button android:id="@+id/copyDiagnosticsButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="@string/copy_diagnostics" />
            <Button android:id="@+id/confirmButton" android:layout_width="match_parent" android:layout_height="44dp" android:backgroundTint="@color/primary" android:text="@string/confirm_auth" android:textColor="#FFFFFF" android:visibility="gone" />
            <Button android:id="@+id/homeButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="返回平台列表" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/accountManagePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical"><Button android:id="@+id/accountManageBackButton" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="44dp" android:text="‹ 返回" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="登录与切换账户" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" /></LinearLayout>
            <TextView android:id="@+id/currentAccountText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="当前账户：default" android:textColor="@color/primary" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:padding="10dp" android:text="本地存储  ·  数据仅保存在本机；联网只用于登录和同步所选教学平台" android:textColor="@color/success" android:textSize="12sp" />
            <LinearLayout android:id="@+id/accountList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <EditText android:id="@+id/accountNameInput" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:hint="账户名称" android:singleLine="true" />
            <EditText android:id="@+id/accountPasswordInput" android:layout_width="match_parent" android:layout_height="48dp" android:hint="加密密码" android:inputType="textPassword" android:singleLine="true" />
            <Button android:id="@+id/accountSwitchButton" android:layout_width="match_parent" android:layout_height="46dp" android:backgroundTint="@color/primary" android:text="创建或切换账户" android:textColor="#FFFFFF" />
            <Button android:id="@+id/accountRebuildButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="忘记密码并重建所填账户" />
            <Button android:id="@+id/accountDeleteButton" android:layout_width="match_parent" android:layout_height="46dp" android:text="删除所填账户" android:textColor="#B3261E" />
        </LinearLayout>

        <ScrollView android:id="@+id/profilePanel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><Button android:id="@+id/profileBackButton" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="44dp" android:text="‹ 返回"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="个人资料" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"/></LinearLayout><ImageView android:id="@+id/personalAvatar" android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" android:contentDescription="@string/app_name" android:scaleType="centerCrop" android:src="@drawable/avatar"/><Button android:id="@+id/avatarButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:text="更换头像"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="昵称" android:textStyle="bold"/><EditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="50dp" android:hint="显示昵称" android:singleLine="true"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="账户名称" android:textStyle="bold"/><EditText android:id="@+id/profileAccountNameInput" android:layout_width="match_parent" android:layout_height="50dp" android:hint="账户名称映射" android:singleLine="true"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="新密码" android:textStyle="bold"/><EditText android:id="@+id/profilePasswordInput" android:layout_width="match_parent" android:layout_height="50dp" android:hint="留空则保持原密码" android:inputType="textPassword" android:singleLine="true"/><Button android:id="@+id/saveProfileButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:backgroundTint="@color/primary" android:text="保存个人资料" android:textColor="#FFFFFF"/></LinearLayout></ScrollView>

        <LinearLayout android:id="@+id/authBar" android:layout_width="match_parent" android:layout_height="52dp" android:background="#FFFFFF" android:elevation="2dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp" android:visibility="gone"><Button android:id="@+id/authBackButton" style="?android:attr/buttonBarButtonStyle" android:layout_width="64dp" android:layout_height="44dp" android:text="‹ 返回"/><TextView android:id="@+id/authStatusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="请完成平台登录" android:textColor="@color/muted" android:textSize="12sp"/><Button android:id="@+id/authConfirmButton" android:layout_width="112dp" android:layout_height="42dp" android:backgroundTint="@color/primary" android:text="完成认证" android:textColor="#FFFFFF" android:textSize="13sp"/></LinearLayout>
        <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/surface" android:focusable="true" android:focusableInTouchMode="true" />
        <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="60dp" android:background="#FFFFFF" android:elevation="8dp" android:gravity="center" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <Button android:id="@+id/tasksTab" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="✓&#10;待办" />
            <Button android:id="@+id/calendarTab" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▣&#10;日历" />
            <Button android:id="@+id/coursesTab" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▦&#10;课程" />
        </LinearLayout>
    </LinearLayout>

    <View android:id="@+id/drawerScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#55000000" android:visibility="gone" />
    <ScrollView android:id="@+id/accountPanel" android:layout_width="296dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#FFFFFF" android:elevation="12dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="账户" android:textColor="@color/ink" android:textSize="27sp" android:textStyle="bold" />
            <ImageView android:id="@+id/accountAvatar" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="18dp" android:contentDescription="@string/app_name" android:scaleType="centerCrop" android:src="@drawable/avatar" />
            <TextView android:id="@+id/drawerAccountSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="当前账户：default" android:textColor="@color/primary" android:textSize="14sp" />
            <Button android:id="@+id/profileManageButton" android:layout_width="match_parent" android:layout_height="46dp" android:text="个人资料  ›" />
            <Button android:id="@+id/accountManageButton" android:layout_width="match_parent" android:layout_height="46dp" android:text="登录与切换账户  ›" />
            <Button android:id="@+id/materialDownloadButton" android:layout_width="match_parent" android:layout_height="46dp" android:text="课程资料下载  ›" />
            <Button android:id="@+id/platformSettingsButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:backgroundTint="@color/primary" android:text="平台登录与同步  ›" android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
    <View android:id="@+id/edgeHandle" android:layout_width="48dp" android:layout_height="match_parent" android:layout_gravity="start" android:layout_marginTop="64dp" android:layout_marginBottom="58dp" android:background="#01000000" />
</FrameLayout>
