<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:statusBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:buttonStyle">@style/Widget.DDL.Button</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.DDL.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:backgroundTint">@color/control</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
